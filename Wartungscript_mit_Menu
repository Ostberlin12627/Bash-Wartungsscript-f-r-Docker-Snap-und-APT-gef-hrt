#!/bin/bash

#Festlegung der Speicherorte für temporäre Dateien.
tempupdate="/tmp/apt-update.log"
tempupgrade="/tmp/apt-upgrade.log"

#Speicherort der Logdatei. Bei einem anderen Benutzer oder System muss der Pfad angepasst werden.
#Die Logdatei wird beim Programmstart angelegt, falls sie noch nicht existiert.
pfadlog="/home/rayano/Dokumente/logs.log"
touch "$pfadlog"

function dockerupdate () {
#Stoppt alle Container des angegebenen Docker-Compose-Projekts, ohne sie zu entfernen.
docker compose -f "$1" stop

#Lädt die aktuellen Images aus der Registry herunter.
docker compose -f "$1" pull

#Baut Images mit Dockerfile neu, ohne den Build-Cache zu verwenden, und prüft auf aktuelle Basis-Images.
docker compose -f "$1" build --no-cache --pull

#Startet die Container im Hintergrund und erstellt sie unabhängig von Änderungen neu.
docker compose -f "$1" up -d --force-recreate

}

#Erstellt und formatiert die Überschriften für die Protokollierung.
function ueberschrift () {

	#local begrenzt die Variable auf diese Funktion. $1 übernimmt den ersten übergebenen Parameter.
        local ueberschrift="$1"
        echo ""
        local trennzeichen="======================================================================================================>"
        echo "$trennzeichen"
        echo "===============================================$ueberschrift=========================================>"
        echo "$trennzeichen"
        echo ""
}

#Aktualisiert die APT-Paketlisten und installierten Pakete und erstellt ein Protokoll.
function systemaktuellisierung () {
    tempupdate="/tmp/apt-update.log"
    tempupgrade="/tmp/apt-upgrade.log"

    #Aktualisiert die Paketlisten und speichert die Ausgaben sowie Fehlermeldungen in einer temporären Datei.
    if sudo apt-get update --error-on=any > "$tempupdate" 2>&1; then
        echo "Paketlisten aktualisiert"

	#Bei erfolgreicher Paketlistenaktualisierung wird das System aktualisiert
        if sudo apt-get upgrade -y > "$tempupgrade" 2>&1; then
            echo "System aktualisiert"

            {
                ueberschrift "Systemaktuellisierung"
		#Aufbau der Tabelle: %-XXs legt die Mindestbreite in Zeichen fest (linksbündig).
                printf "%-30s | %-25s | %s\n" \
                    "Paketname" "Alte Version" "Neue Version"

                echo "______________________________________________________________________________________________"

		#Speichert alle Zeilen, die mit "Entpacken von" beginnen, in einem Array.
		##grep sucht nach den entsprechenden Zeilen.
                mapfile -t pakete < <(grep '^Entpacken von ' "$tempupgrade")

		#Durchläuft das Array und extrahiert Paketnamen sowie Versionsnummern.
		#Die Werte werden in Variablen gespeichert und anschließend tabellarisch ausgegeben.
                for index in "${pakete[@]}"; do
                    paket2="${index#Entpacken von }"
                    paketname="${paket2%% (*}"
                    neueversion1="${paket2#*(}"
                    neueversion="${neueversion1%%)*}"
                    alteversion1="${neueversion1#*(}"
                    alteversion="${alteversion1%%)*}"

                    printf "%-30s | %-25s | %s\n" \
                        "$paketname" "$alteversion" "$neueversion"

                #Beendet die Schleife
		done

            }

        else
            {
		#Bei fehlgeschlagener Systemaktualisierung wird die ursprüngliche Fehlermeldung ausgegeben.
		#Auch wenn das Programm mit Strg + C abgebrochen wird, wird es in die Logs geschrieben.
                ueberschrift "Fehler beim Aktuellisieren des Systems"
                cat "$tempupgrade"
            }
        fi

    else
        {  
	    #Bei fehlgeschlagener Paketlistenaktualisierung wird ein Fehlerbericht erstellt.
            ueberschrift "Fehlerbericht"

            #Aufbau der Tabelle: %-XXs legt die Mindestbreite in Zeichen fest (linksbündig).
            printf "%-70s | %s\n" "Quelle" "Fehlergrund"

            echo "______________________________________________________________________________________________"
	    #Speichert alle Zeilen mit passenden APT-Fehlermeldungen in einem Array.
	    #Suchparameter "Fehlschlag beim Holen von"
            mapfile -t fehlerliste < <(grep '^E: Fehlschlag beim Holen von ' "$tempupdate")

	    #Durchläuft das Array und extrahiert die benötigten Fehlerinformationen.
	    #Die Werte werden in Variablen gespeichert und anschließend tabellarisch ausgegeben.
            for index in "${fehlerliste[@]}"; do
                anfang="${index#*von }"
                fehler="${anfang%%Tem*}"

                printf "%-70s | %s\n" \
                    "$fehler" "Quelle nicht gefunden oder erreichbar"
            done

        }
    fi
    #Löscht die temporären Dateien nach Abschluss der Auswertung.
    rm -f "$tempupdate" "$tempupgrade"
}

#Aktualisiert die installierten Snap-Pakete und erstellt ein Protokoll.
function snapaktuellisierung () {
    tmpsnap="/tmp/snap.alt"

    #Speichert den aktuellen Zustand der installierten Snap-Pakete in einer temporären Datei.
    snap list > "$tmpsnap"

    #Aktualisiert die installierten Snap-Pakete und prüft den Rückgabewert.
    if sudo snap refresh > /tmp/snap-fehler.log 2>&1; then
        echo "Snap-Aktualisierung erfolgreich"

    else
	#Bei fehlgeschlagener Snap-Aktualisierung wird die ursprüngliche Fehlermeldung protokolliert.
	#Die Funktion wird mit dem Fehlerstatus 1 beendet.
	ueberschrift "Fehler"
	cat /tmp/snap-fehler.log
	rm -f "/tmp/snap-fehler.log"

	return 1
    fi
    #Aufbau der Tabelle: %-XXs legt die Mindestbreite in Zeichen fest (linksbündig).
    printf "%-25s | %-35s | %-35s | %s\n" \
        "Paketname" "Alte Version" "Neue Version" "Herausgeber"

    echo "_____________________________________________________________________________________________________________________"

    #Speichert die Snap-Paketlisten vor und nach der Aktualisierung in zwei Arrays.
    #awk überspringt mit NR > 1 jeweils die erste Zeile (Tabellenüberschrift).
    #Zeite Liste enthält die neue Version, der Restliche Inhalt, ist identisch.
    mapfile -t snap < <(awk 'NR > 1' "$tmpsnap")
    mapfile -t snapneu < <(snap list | awk 'NR > 1')

    #Verschachtelte for-Schleifen zum Vergleichen der alten und neuen Snap-Paketlisten.
    #Die äußere Schleife durchläuft die alte Liste, die innere Schleife die neue Liste.
    for snaps in "${snap[@]}"; do

	#Extraiert, paketname, alte version und den Hersteller.Beispiel: $1 steht für Spalten 1
        paketname=$(echo "$snaps" | awk '{print $1}')
        alteversion=$(echo "$snaps" | awk '{print $2}')
        herausgeber=$(echo "$snaps" | awk '{print $5}')

        for snapse in "${snapneu[@]}"; do

            #Extrahiert Paketnamen, alte Version und Herausgeber mithilfe von awk.
	    #$1, $2 und $5 stehen für die jeweiligen Spalten der Paketliste.
            neueversion=$(echo "$snapse" | awk '{print $2}')
            paketnameneu=$(echo "$snapse" | awk '{print $1}')

	    #Vergleicht die Paketnamen der alten und neuen Liste.
	    #Bei Übereinstimmung werden die Werte anschließend tabellarisch ausgegeben.
            if [[ "$paketname" == "$paketnameneu" ]]; then

		#Gibt die zugeordneten Paketinformationen entsprechend der definierten Tabellenformatierung aus.
                printf "%-25s | %-35s | %-35s | %s\n" \
                    "$paketname" "$alteversion" "$neueversion" "$herausgeber"
            fi
        done
    done
    #Löscht die temporäre Datei nach Abschluss der Auswertung.
    rm -f "$tmpsnap"
}

#Ermöglicht die Anzeige der eigenen und der originalen APT-Protokolle.
#muss ich noch bearbeiten
#Ermöglicht die Anzeige der eigenen und der originalen APT-Protokolle.
function logs_anzeigen () {
    ologs="/var/log/apt/history.log"

    while true; do
	echo ""
        echo "Welche Logs sollen angezeigt werden?
                1) Selbst erstellte Logs
                2) Originale Logs
                3) Zurück zum Hauptmenü"
	echo ""
        read -r -p "Eingabe: " logauswahl

        case "${logauswahl,,}" in

            1)
                cat "$pfadlog"
                ;;

            2)
                cat "$ologs"
                ;;

            3)
                return 0
                ;;

            *)
                echo "Die Eingabe ist ungültig!"
                ;;
        esac
    done
}

#Abhier läuft das eigentliche Programm alles davor sind Funktionien die hier verwendent werden
#Programm läuft bis es beendet wird
while true; do
echo ""
echo "Hinweis:"
echo "Orginale Logs finden sich unter"
echo "/var/log/apt/history.log"
echo "Das Passwort für erweiterte Rechte kann angefordert werden"
echo ""
echo ""
echo "Wähle aus dem Menu:
=================================================
1) System aktuellisieren
2) Drittanbieter Software aktuellisieren (Snap)
3) Docker Aktuellisieren (aktuell keine logs)
4) logs auslesen
0) Prgramm beenden"
echo ""

#Abfangen einer Userauswahl, nur die das was angezeigt wird, kann ausgewählt werden. Für Docker gibt es aktuell einen Platzhalter
read -r -p "Eingabe " input
#Auswertung der Usereingabe und durchführen des Entsprechenden Punktes
#Anmerkung da alle Ausgaben umgeleitet werden habe ich trotzdem eigene für die Konsolenausgabe hinzugefügt
case ${input,,} in
	"1")
	echo "" >> "$pfadlog"
	date >> "$pfadlog"
	echo "" >> "$pfadlog"
	echo "System wird aktuellisiert"
	systemaktuellisierung >> "$pfadlog"
	echo "Aktuellisierung durchgeführt, zurück zum Menu"
	;;
	"2")
	echo "" >> "$pfadlog"
	date >> "$pfadlog"
	echo "" >> "$pfadlog"
	echo "Drittanbieter Software wird aktuellisiert"
	snapaktuellisierung >> "$pfadlog" 2>&1
	echo "Aktuellisierung durchgeführt, zurück zum Menu"
	;;
	"3")
	echo"" >> "$pfadlog"
	read -r -p "Wo liegt die Docker yaml/yml Datei? gebe den Pfad mit / an. Beispiel: /opt/docker/compose.yaml " dockerpfad
	dockerupdate "$dockerpfad"
	echo "Docker compose wurde aktuellisiert"
	date >> "$pfadlog"
	echo "Docker compose wurde aktuellisiert" >> "$pfadlog"
	;;
	"4")
	logs_anzeigen
	;;
	"0")
	echo ""
	echo "Das Programm wird beendet"
	exit 0
	;;
	*)
	echo ""
	echo "Die eingabe ist Ungültig"
	;;
esac
done
